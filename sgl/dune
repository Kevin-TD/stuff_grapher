(ocamllex lexer)
(menhir (modules parser))
(dirs :standard \ latex_parser)

(library
  (name sgl)
  (wrapped false)
  (libraries yojson)
  (modules parser lexer ast builtins config interpreter passes embedded_constants sgl_consts test_suite))

(executable
  (name main)
  (modules main)
  (libraries sgl)
  (modes native))

(executable
  (name js_main)
  (modules js_main)
  (libraries sgl js_of_ocaml)
  (preprocess (pps js_of_ocaml-ppx))
  (modes js))

(rule
 (targets embedded_constants.ml)
 (deps constants.json)
 (action
  (with-stdout-to %{targets}
   (progn
    (echo "let json_str = {|")
    (cat constants.json)
    (echo "|}")))))