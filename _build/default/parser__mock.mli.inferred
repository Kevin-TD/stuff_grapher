type token =
    THEN
  | RIGHT_SQR_BRACKET
  | RIGHT_PAREN
  | REAL of float
  | PLUS
  | NOT_EQUAL
  | NEWLINE
  | MULT
  | MINUS
  | LTE
  | LT
  | LEFT_SQR_BRACKET
  | LEFT_PAREN
  | INTEGER of int
  | IF
  | IDENT of string
  | GTE
  | GT
  | FUN
  | EXP
  | EQUAL
  | EOF
  | ELSE
  | DIV
  | COMPARE
  | COMMA
  | ARROW
val menhir_begin_marker : int
val xv_stmts : Ast.prog
val xv_stmt : Ast.stmt
val xv_separated_nonempty_list_COMMA_expr_ : Ast.expr list
val xv_separated_list_COMMA_expr_ : Ast.expr list
val xv_rev_expr_list_elems : Ast.expr list
val xv_main : Ast.prog
val xv_loption_separated_nonempty_list_COMMA_expr__ : Ast.expr list
val xv_expr_list_elems : Ast.expr list
val xv_expr : Ast.expr
val menhir_end_marker : int
